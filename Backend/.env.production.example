# Copy / merge into .env.production on the AWS server.
# You previously used Railway — replace ALL DB_* lines with local MariaDB below.

NODE_ENV=production
APP_PORT=3002
APP_PUBLIC_URL=https://sevenwingstechnologies.in
SESS_SECRET=replace-with-a-long-random-secret

# ---- Local MariaDB on THIS EC2 box (NOT Railway) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER_NAME=hrms
DB_PASSWORD=replace-with-strong-db-password
DB_NAME=db_penggajian3
# Must be false for local MariaDB (Railway often used true)
DB_SSL=false

# Email (optional)
EMAIL_USER=
EMAIL_PASSWORD=

# Optional S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_BUCKET_NAME=
