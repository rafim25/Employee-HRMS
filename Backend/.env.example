# development | production
NODE_ENV=development
APP_PORT=3002
APP_PUBLIC_URL=http://localhost:3002
# Use a long random string in production
SESS_SECRET=change-this-session-secret

# MySQL / MariaDB (local on same machine — typical AWS EC2 setup)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER_NAME=hrms
DB_PASSWORD=your_db_password
DB_NAME=db_penggajian3
# false for local MariaDB; true only for Amazon RDS with SSL
DB_SSL=false

# AWS production with MariaDB on the same EC2 box:
#   cp .env.production.example .env.production
#   Edit passwords, then:
#   sudo mysql < scripts/createMariaDbUser.sql
#   NODE_ENV=production npm run db:setup
#   pm2 start ecosystem.config.cjs

# Email (share shortlisted candidates, credentials mail)
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Optional — if unset, resumes/photos are saved under Backend/public/uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_BUCKET_NAME=
