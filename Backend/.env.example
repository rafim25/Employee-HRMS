# development | production
NODE_ENV=development
APP_PORT=3002
APP_PUBLIC_URL=http://localhost:3002
# Use a long random string in production
SESS_SECRET=change-this-session-secret

# MySQL (local or RDS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER_NAME=root
DB_PASSWORD=your_mysql_password
DB_NAME=db_penggajian3
# Set true for Amazon RDS / managed MySQL with SSL
DB_SSL=false

# Production example (copy to .env.production on the server):
# NODE_ENV=production
# APP_PORT=3002
# APP_PUBLIC_URL=https://sevenwingstechnologies.in
# SESS_SECRET=use-a-long-random-secret
# DB_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
# DB_PORT=3306
# DB_USER_NAME=hrms_app
# DB_PASSWORD=strong-password
# DB_NAME=db_penggajian3
# DB_SSL=true

# Email (share shortlisted candidates, credentials mail)
# Prefer SMTP_*; EMAIL_* is supported as a legacy alias
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your-app-password

# Optional — if unset, resumes/photos are saved under Backend/public/uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_BUCKET_NAME=

# Bootstrap a fresh DB (creates DB + tables + sessions + admin + HR defaults):
#   NODE_ENV=production npm run db:setup
# Export schema SQL after setup:
#   npm run db:export-schema
